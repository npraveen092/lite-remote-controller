# Public hostname used by Caddy for the signaling service.
SIGNALING_DOMAIN=signal.example.com

# TURN configuration. Do not commit real secrets.
TURN_REALM=signal.example.com
TURN_USERNAME=lrc-turn
TURN_PASSWORD=replace-with-a-long-random-secret

# UDP relay range. Open the same range in the VPS firewall.
TURN_MIN_PORT=49160
TURN_MAX_PORT=49260
